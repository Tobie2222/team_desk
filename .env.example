# Application
NODE_ENV=development
PORT=3000

# MySQL (host ports from docker-compose.yml)
MYSQL_HOST=localhost
MYSQL_PORT=33069
MYSQL_ROOT_PASSWORD=change-me-local-only
MYSQL_DATABASE=teamdesk
MYSQL_USER=teamdesk
MYSQL_PASSWORD=change-me-local-only

# MongoDB (host ports from docker-compose.yml)
MONGO_HOST=localhost
MONGO_PORT=28000
MONGO_DB_NAME=teamdesk
MONGO_USER=teamdesk
MONGO_PASSWORD=change-me-local-only
# Docker Compose initialization credentials
MONGO_INITDB_ROOT_USERNAME=teamdesk
MONGO_INITDB_ROOT_PASSWORD=change-me-local-only

# Redis (host port from docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6380

JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
